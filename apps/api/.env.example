# Copy to apps/api/.env. Never commit real credentials.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATA_DIR=.data

# Both keys are required to use live voice with real record creation.
OPENAI_API_KEY=
OPENAI_BACKEND_MODEL=gpt-5.6-terra
AMBIGUOUS_API_KEY=
# Default assignee: FADS-Claw in the FADS workspace. Change for another workspace.
AMBIGUOUS_ASSIGNEE_ID=e291aee4-3f6b-4f34-9860-6d9e7e26c802

# 'live' saves to Ambiguous.ai. 'demo' explicitly simulates record creation,
# including for live audio calls. Text demo always avoids external APIs.
AMBIGUOUS_MODE=live
