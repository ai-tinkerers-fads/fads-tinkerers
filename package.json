{
  "name": "fads-tinkerers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8808",
    "dev:voice": "concurrently -k -n voice-api,voice-web -c cyan,green \"npm run dev --workspace apps/api\" \"npm run dev --workspace apps/web\"",
    "build": "next build && npm run build --workspaces --if-present",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-8808}",
    "dispatcher": "tsx scripts/dispatcher.ts",
    "seed": "tsx scripts/seed-ambiguous.ts",
    "backfill:links": "tsx scripts/backfill-artifact-links.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:smoke": "node scripts/smoke.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  }
}
